# ── SQL Server connection ──────────────────────────────────────────────────
SERVER_NAME=your-server.database.windows.net
DATABASE_NAME=your-database

# Set to true to allow only read operations (SELECT, list, describe)
READONLY=true

# TLS — set to true for local SQL Server instances with self-signed certs
TRUST_SERVER_CERTIFICATE=false

# Connection timeout in seconds (default: 30)
CONNECTION_TIMEOUT=30

# ── Auth: Option 1 — SQL Server login (no Azure creds needed) ───────────────
# Use this for local dev with SSMS-style connections.
# If both SQL_USER and SQL_PASSWORD are set, Azure credentials are NOT used.
SQL_USER=your-sql-username
SQL_PASSWORD=your-sql-password

# ── Auth: Option 2 — Azure AD (comment out SQL_USER/SQL_PASSWORD above) ───────
# Managed Identity (Azure): set automatically when deployed, no extra vars needed.
# Service principal (local): uncomment and fill in below.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ── HTTP / SSE mode ─────────────────────────────────────────────────
# Set PORT to enable HTTP/SSE transport (exposes /sse, /tools, /health).
# Leave unset to run in stdio mode (Claude Desktop / VS Code Agent).
PORT=8080
